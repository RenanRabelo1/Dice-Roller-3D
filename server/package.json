{
  "name": "dice-roller-server",
  "private": true,
  "type": "module",
  "description": "API do histórico de jogadas do DiceRoller (Fastify + MongoDB Atlas).",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "fastify": "^5.12.8",
    "mongodb": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "mongodb-memory-server": "^11.3.0",
    "typescript": "~7.0.2",
    "vitest": "4.1.12"
  }
}
