# Copie para server/.env (que não vai para o git) e preencha.
# Atlas → Database → Connect → Drivers → Node.js. Use um usuário só deste app (readWrite em "diceroller").
MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=dice-roller
MONGODB_DB=diceroller
PORT=3001
HOST=127.0.0.1
# Origens do front que podem chamar a API (separadas por vírgula).
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
